VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Set to true to run the app in demo mode without signing in (local dev only)
# VITE_DISABLE_AUTH=true

# ── Upstash Redis (required for production scale) ──
# Free tier: https://console.upstash.com → Create Redis Database → REST API tab
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Optional: Discord bot to monitor communities (invite the bot to servers you control)
DISCORD_BOT_TOKEN=
# Comma-separated keywords to match in messages (case-insensitive)
DISCORD_KEYWORDS=hiring,for hire,freelance,freelancer,looking for,job,gig,hire,seeking

# ── Community Gig Sources (Craigslist) ──
# 100% free with no API key required.
# Craigslist: scrapes gig listings (computer, creative, writing) from multiple cities
# Optional env vars to customize:
# CL_CITIES=lasvegas,newyork,sfbay,losangeles,chicago,seattle,austin,denver,atlanta,boston
# CL_CATEGORIES=cpg,crg,wrg
# No auth needed — just run: node scripts/fetch-x.js
